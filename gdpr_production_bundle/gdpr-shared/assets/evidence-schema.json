{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GDPR Evidence Record",
  "type": "object",
  "required": [
    "evidence_id",
    "tier",
    "source",
    "collected_at"
  ],
  "properties": {
    "tier": {
      "enum": [
        "tier_1_automated",
        "tier_2_prompted",
        "tier_3_document",
        "human_review"
      ]
    }
  }
}
